/*
 * Edin Keyboard Shield — 3×5 matrix on YD-RP2040 2022-v1.3
 *
 * Columns: GPIO 0, 1, 2, 3, 4  (active-high outputs)
 * Rows:    GPIO 5, 6, 7        (active-high inputs, internal pull-down)
 *
 * Diode direction: col2row (column drives, row reads)
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    /*
     * Physical layout for ZMK Studio.
     * Defines the visual position of every key so ZMK Studio can
     * render the keyboard and let you remap keys interactively.
     *
     * Format:  &key_physical_attrs  width  height  x  y  rot  rot-x  rot-y
     * Units are centi-key-units (1U = 100).
     */
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys = <
            /* Row 0 — 5 keys */
            &key_physical_attrs 100 100   0   0 0 0 0
            &key_physical_attrs 100 100 100   0 0 0 0
            &key_physical_attrs 100 100 200   0 0 0 0
            &key_physical_attrs 100 100 300   0 0 0 0
            &key_physical_attrs 100 100 400   0 0 0 0

            /* Row 1 — 5 keys */
            &key_physical_attrs 100 100   0 100 0 0 0
            &key_physical_attrs 100 100 100 100 0 0 0
            &key_physical_attrs 100 100 200 100 0 0 0
            &key_physical_attrs 100 100 300 100 0 0 0
            &key_physical_attrs 100 100 400 100 0 0 0

            /* Row 2 — 5 keys */
            &key_physical_attrs 100 100   0 200 0 0 0
            &key_physical_attrs 100 100 100 200 0 0 0
            &key_physical_attrs 100 100 200 200 0 0 0
            &key_physical_attrs 100 100 300 200 0 0 0
            &key_physical_attrs 100 100 400 200 0 0 0
        >;
    };

    /*
     * Matrix transform — maps (row, col) pairs to sequential
     * key indices that the keymap references.
     */
    default_transform: key_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <3>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
        >;
    };

    /*
     * Key-scan matrix driver.
     *
     * YD-RP2040 GPIOs:
     *   Columns (outputs): GP0, GP1, GP2, GP3, GP4
     *   Rows    (inputs):  GP5, GP6, GP7
     */
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
            = <&gpio0 0 GPIO_ACTIVE_HIGH>
            , <&gpio0 1 GPIO_ACTIVE_HIGH>
            , <&gpio0 2 GPIO_ACTIVE_HIGH>
            , <&gpio0 3 GPIO_ACTIVE_HIGH>
            , <&gpio0 4 GPIO_ACTIVE_HIGH>
            ;

        row-gpios
            = <&gpio0 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};

/*
 * Add a storage partition for ZMK Studio settings persistence.
 * The rpi_pico board has 2 MB of flash. We carve 128 KB from the
 * end for NVS storage and shrink the code partition accordingly.
 */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        storage_partition: partition@1e0000 {
            label = "storage";
            reg = <0x1e0000 DT_SIZE_K(128)>;
        };
    };
};
